<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    材料轴。全项目只有这一张材料表，兵器与防具共用。
    材料本身就是物品（MaterialDef 继承 ThingDef），不再另立 ThingDef，
    因此"铁"在项目里只存在一份，旧武器材料表（weapon_materials）已删。

    等级由劣到优：布、皮、木材、珊瑚、青铜、铁、钢、秘银、精金、以太。
    （黑曜石已移除；石制武器没有。）
    这张表就是装备的「材料等级表」：tier 定档次，damageBonus 加到兵器基座面板上、armorBonus 加到每件甲的槽位底防上，
    两者都再乘品质。兵器只认 damageBonus，甲只认 armorBonus（能缝甲的材料才填）。
      档 材料  兵器加成 甲加成
      0  布     -       0
      1  皮     -       2
      2  木材   0       -
      3  珊瑚   2       -
      4  青铜   4       -
      5  铁     7       4
      6  钢     12      7
      7  秘银   18      11
      8  精金   25      15
      9  以太   33      20
    weaponUsable / armorUsable 决定它能打兵器还是能缝甲——
    布和皮做不了兵器；铁以下的装备只做布甲皮甲，木材/珊瑚/青铜也缝不了甲。
  -->
  <MaterialDef>
    <defName>布</defName>
    <label>布</label>
    <description>布制。最便宜也最不经打，刚出门那身就是它。</description>
    <category>Cloth</category>
    <stackLimit>999</stackLimit>
    <marketValue>8</marketValue>
    <tier>0</tier>
    <weaponUsable>false</weaponUsable>
    <armorUsable>true</armorUsable>
    <damageBonus>0</damageBonus>
    <armorBonus>0</armorBonus>
    <valueFactor>80</valueFactor>
  </MaterialDef>

  <MaterialDef>
    <defName>皮</defName>
    <label>皮</label>
    <description>皮革。比布韧，猎户与游侠常穿。</description>
    <category>Cloth</category>
    <stackLimit>999</stackLimit>
    <marketValue>20</marketValue>
    <tier>1</tier>
    <weaponUsable>false</weaponUsable>
    <armorUsable>true</armorUsable>
    <damageBonus>0</damageBonus>
    <armorBonus>2</armorBonus>
    <valueFactor>130</valueFactor>
  </MaterialDef>

  <MaterialDef>
    <defName>木材</defName>
    <label>木材</label>
    <description>伐木取得的原木料，也能削成木器。</description>
    <category>RawMaterial</category>
    <stackLimit>999</stackLimit>
    <marketValue>3</marketValue>
    <tier>2</tier>
    <weaponUsable>true</weaponUsable>
    <armorUsable>false</armorUsable>
    <damageBonus>0</damageBonus>
    <armorBonus>0</armorBonus>
    <valueFactor>160</valueFactor>
  </MaterialDef>

  <MaterialDef>
    <defName>珊瑚</defName>
    <label>珊瑚</label>
    <description>海底采来的珊瑚骨，质脆却锋利。</description>
    <category>RawMaterial</category>
    <stackLimit>999</stackLimit>
    <marketValue>10</marketValue>
    <tier>3</tier>
    <weaponUsable>true</weaponUsable>
    <armorUsable>false</armorUsable>
    <damageBonus>2</damageBonus>
    <armorBonus>0</armorBonus>
    <valueFactor>175</valueFactor>
