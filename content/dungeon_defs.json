    "guardPercent": 35,
    "guards": [
      {
        "weight": 4,
        "title": "石室守卫",
        "text": "黑暗里亮起几对眼睛，盘踞此处的东西被惊醒了。",
        "families": ["rat"]
      },
      {
        "weight": 4,
        "title": "石室守卫",
        "text": "几具披甲骸骨从壁龛里站起，锈剑在石地上拖出火星。",
        "families": ["skeleton"]
      },
      {
        "id": "acid_slimes",
        "weight": 3,
        "title": "酸液软泥",
        "text": "墙缝里淌出几团灰绿的黏液，腐蚀声沿着石缝一路爬近。",
        "families": ["slime"]
      },
      {
        "id": "bog_leeches",
        "weight": 2,
        "title": "墓沼水蛭",
        "text": "一滩发黑的水忽然鼓起，几条吸饱血的水蛭扭动着扑来。",
        "families": ["leech"]
      },
      {
        "id": "grave_hounds",
        "weight": 2,
        "title": "墓穴猎犬",
        "text": "锈蚀的锁链拖过地面，几头骨犬从侧廊包抄过来。",
        "families": ["hound"]
      },
      {
        "id": "banshee_choir",
        "weight": 1,
        "title": "墓窟哀歌",
        "text": "石壁深处传来一声长啸，寒意随着第二道回声灌入骨髓。",
        "families": ["banshee"]
      },
      {
        "id": "basilisk_guard",
        "weight": 3,
        "title": "石化蜥卫",
        "text": "一道冷光从石柱间掠过，鳞甲摩擦声已逼到近前。",
        "families": ["basilisk"]
      },
      {
        "id": "blood_beasts",
        "weight": 2,
        "title": "血肉兽群",
        "text": "暗红色的肉块从阴影里挤出，喘息声像漏风的风箱。",
        "families": ["flesh"]
      },
      {
        "id": "abyss_larvae",
        "weight": 2,
        "title": "深渊幼体",
        "text": "石门后传来湿重的刮擦声，幼小的深渊蠕虫扭身钻出裂缝。",
        "families": ["abyss"]
      },
      {
        "id": "flesh_hunters",
        "weight": 2,
        "title": "肉瘤猎手",
        "text": "血肉从石棺里撕裂而出，带着腥气分两路扑向队伍。",
        "families": ["flesh"]
      }
    ],
    "bosses": [
      {
        "weight": 3,
        "title": "地精营地",
        "text": "篝火旁，一个披着锈甲的高大身影拄剑站起，地精们尖叫着散开。",
        "families": ["goblin"]
      },
      {
        "weight": 2,
        "title": "食人魔酋长",
        "text": "骨堆上坐着一头满身油污的食人魔，它舔了舔巨斧的刃口，咧嘴笑了。",
        "families": ["ogre"]
      },
      {
        "weight": 2,
        "title": "迷宫之主",
        "text": "回廊尽头传来蹄子刨地的声音，一对弯角从黑暗里低了下来。",
        "families": ["minotaur"]
      },
      {
        "weight": 2,
        "title": "山岭巨魔",
        "text": "洞顶的阴影动了。一头青灰皮肤的巨魔垂下长臂，伤疤在它身上一道道合拢。",
        "families": ["troll"]
      },
      {
        "weight": 3,
        "title": "遗迹之主",
        "text": "最深处的石座上，一头庞然的东西缓缓抬起头来。",
        "families": ["wolf"]
      },
      {
        "weight": 3,
        "title": "遗迹之主",
        "text": "尘封的王座上坐着一具戴冠的骸骨，眼窝里燃起幽火。",
        "families": ["skeleton"]
      },
      {
        "weight": 1,
        "title": "腐蚀母体",
        "text": "房间中央的黏液聚成一团，表面浮起一张模糊的人脸。",
        "families": ["slime"]
      },
      {
        "weight": 1,
        "title": "墓窟女妖",
        "text": "王座后的影子抬起白骨般的手，刺耳的哭声震落了顶上的灰。",
        "families": ["banshee", "hound"]
      },
      {
        "weight": 1,
        "title": "熔炉巨兽",
        "text": "熔岩般的裂纹在巨兽胸口亮起，它每走一步，石室都随之震颤。",
        "families": ["magma"]
      },
      {
        "weight": 3,
        "title": "骸骨巨像",
        "text": "巨大的骸骨从石座上站起，王冠里燃着四团幽蓝的火。",
        "families": ["colossus", "hound"]
      },
      {
        "weight": 2,
        "title": "深渊蠕虫",
        "text": "地底传来一声漫长的轰鸣，石壁裂开，露出吞噬过整支军队的巨口。",
        "families": ["abyss"]
      },
      {
        "weight": 1,
        "title": "腐肉泰坦",
        "text": "厚重的缝线在巨人身上绷断，腐肉泰坦拖着残破肢体扑向众人。",
        "families": ["flesh"]
      }
    ],
    "clearedText": "{0}已肃清。",
    "fogName": "？",
    "quest": {
      "starsPerTier": 3,
      "bossText": "委托要找的正主就在这一间，见了生人便扑了上来。",
      "leaveLabel": "撤离",
      "arriveText": "接下委托「{0}」，马车把众人送到了地头。",
      "doneText": "委托「{0}」了结，马车把众人接回了领地。",
      "abandonText": "撤出了「{0}」，马车把众人接回了领地。",
      "board": {
        "perDay": 1,
        "lifeDays": 3,
        "idBase": 1000,
        "starsMin": 2,
        "starsMax": 10,
        "starsEarly": 4,
        "rampDays": 20,
        "moneyBase": 100,
        "moneyPerStar": 70,
        "crPerStar": 1.5,
        "partyBase": 2,
        "sites": [
          {
            "name": "塌陷古井",
            "description": "{0}外头那口古井塌出一个窟窿，底下连着不知多深的石道。下去探到底，把盘在最里头的东西除掉。",
            "rumors": [
              "井边打水的妇人说，夜里井口会往外冒凉风，风里有铁锈味。",
              "有人往井里丢过一盏灯，灯落了很久才灭。"
            ],
            "dungeonId": "ruins"
          },
          {
            "name": "无名墓窖",
            "description": "{0}的守墓人说墓地后头的土塌了，露出一道没人记得的墓窖门。进去看看，把扰得四邻不安的东西清掉。",
            "rumors": [
              "守墓人发誓说门是从里头推开的。",
              "附近的狗这几天都不肯往墓地那边走。"
            ],
            "dungeonId": "ruins"
          },
          {
            "name": "旧要塞地牢",
            "description": "{0}北边那座废要塞的地牢又有了动静。探进最深一层，把占了那里的东西解决掉。",
            "rumors": [
              "拾荒的说地牢里的铁栅都被拗弯了，往外弯的。",
              "听说要塞弃守那年，牢里的人没放出来。"
            ],
            "dungeonId": "ancient_battlefield"
          },
          {
            "name": "沉钟修道院",
            "description": "{0}一带的人说山里那座废修道院的地下又响起了钟声。下到底下，把作怪的东西找出来除掉。",
            "rumors": [
              "钟楼早就塌了，钟声却是从地底下传上来的。",
              "去年进去的两个修士只回来了一个，回来后再没开过口。"
            ],
            "dungeonId": "forest"
          },
          {
            "name": "盐矿老坑",
            "description": "{0}的盐商说老盐坑里接连少了人。顺着坑道探到底，把伤人的东西清掉。",
            "rumors": [
              "坑道壁上的盐霜被什么东西舔得发亮。",
              "矿工说最深那层的支架上有爪印，比人手还宽。"
            ],
            "dungeonId": "ruins"
          },
          {
            "name": "雾沼石窟",
            "description": "{0}外的沼泽退了水，露出一座石窟。进去探个究竟，把盘踞最深处的东西除掉。",
            "rumors": [
              "采苇子的说石窟口的雾，退水那天就没散过。",
              "有人在窟口捡到过一枚旧币，上面的头像没人认得。"
            ],
            "dungeonId": "forest"
          }
        ]
      }
    }
  },
